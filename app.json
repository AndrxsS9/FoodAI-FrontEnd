{
  "expo": {
    "name": "FoodAI",
    "slug": "foodai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "foodai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/FoodAI_android_adaptive_foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.foodai.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a FoodAI acceder a tus fotos para seleccionar ingredientes.",
          "cameraPermission": "Permite a FoodAI usar la cámara para fotografiar ingredientes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e53e26d8-f026-47ca-9e0c-3baf9778f0fb"
      }
    },
    "owner": "andresyi"
  }
}
